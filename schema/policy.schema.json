{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Application-type policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_type", "characteristics", "static_checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "application_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string" },
    "characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "meaning": { "type": "string", "minLength": 10, "maxLength": 200 },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "static_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "framework", "fail_on", "checks"],
      "properties": {
        "tool": { "const": "checkov" },
        "framework": { "type": "string" },
        "custom_checks_dir": { "type": "string" },
        "fail_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["critical", "high", "medium", "low"] }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity"],
            "properties": {
              "id": { "type": "string", "pattern": "^CKV[0-9]*_[A-Z0-9_]+$" },
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
